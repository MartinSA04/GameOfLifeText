{
  "name": "game_of_life_text",
  "short_name": "life text",
  "description": "Type a word and watch two gliders per pixel collide into still-life blocks that spell it out. Conway's Game of Life, running in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#070a08",
  "theme_color": "#070a08",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
